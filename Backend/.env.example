PORT=9000
MONGODB_URI=mongodb://127.0.0.1:27017/quirex
# Frontend URL allowed to call the API. Separate several with commas.
CLIENT_URL=http://localhost:5173

# Secret that signs login tokens. Use a long random string, for example the output of:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
JWT_SECRET=
JWT_EXPIRES_IN=7d

# Used only by `npm run seed:admin`
ADMIN_EMAIL=admin@quirex.com
ADMIN_PASSWORD=

# Optional
# Set to 1 when running behind a hosting proxy (Render, Railway, Heroku...).
TRUST_PROXY=0
# Login, register and contact attempts allowed per IP every 15 minutes.
RATE_LIMIT_MAX=20
# Store uploaded images on Cloudinary instead of this computer. Copy the
# "API environment variable" from the Cloudinary dashboard (API Keys page).
# CLOUDINARY_URL=cloudinary://<api_key>:<api_secret>@<cloud_name>
# Cloudinary folder for the images (default: quirex).
# CLOUDINARY_FOLDER=quirex
# Folder for uploaded images when Cloudinary is not used (default: Backend/uploads).
# UPLOAD_DIR=/var/data/uploads
